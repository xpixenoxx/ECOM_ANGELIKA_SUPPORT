# ==========================================
# Angelika Fashions - Environment Template (.env.example)
# Copy this file to .env.local and fill in your actual credentials.
# ==========================================

# ------------------------------------------
# Supabase Configuration
# ------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ------------------------------------------
# Payments - Razorpay
# ------------------------------------------
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=...
RAZORPAY_WEBHOOK_SECRET=...

# ------------------------------------------
# Payments - Stripe
# ------------------------------------------
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ------------------------------------------
# WhatsApp Business Cloud API
# ------------------------------------------
WHATSAPP_PHONE_NUMBER_ID=...
WHATSAPP_ACCESS_TOKEN=...
WHATSAPP_WEBHOOK_VERIFY_TOKEN=angelika_verify_2024
WHATSAPP_APP_ID=...
WHATSAPP_APP_SECRET=...
WHATSAPP_BUSINESS_ACCOUNT_ID=...

# ------------------------------------------
# Email (SendGrid / SMTP)
# ------------------------------------------
SENDGRID_API_KEY=...
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=vidhya@angelikafashions.com
SMTP_PASSWORD=...
EMAIL_FROM=vidhya@angelikafashions.com
EMAIL_FROM_NAME="Angelika Fashions"

# ------------------------------------------
# Google Maps
# ------------------------------------------
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=...

# ------------------------------------------
# Monitoring & Logging
# ------------------------------------------
SENTRY_DSN=...
NEXT_PUBLIC_SENTRY_DSN=...
SLACK_WEBHOOK_URL=...

# ------------------------------------------
# Feature Flags
# ------------------------------------------
NEXT_PUBLIC_ENABLE_VIRTUAL_TRYON=false
NEXT_PUBLIC_ENABLE_STYLIST_CHAT=false

