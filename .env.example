# ==========================================
# Angelika Fashions - Environment Template (.env.example)
# Copy this file to .env.local and fill in your actual credentials.
# NEVER commit real secrets to Git.
# ==========================================

# ------------------------------------------
# Application URL
# ------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ------------------------------------------
# Supabase Configuration
# ------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ------------------------------------------
# Payments - Razorpay Standard Checkout (Sole Online Gateway)
# Use "test" + rzp_test_* for Test Mode; "live" + rzp_live_* for Live Mode.
# ------------------------------------------
RAZORPAY_ENV=test
NEXT_PUBLIC_RAZORPAY_ENV=test
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=...
RAZORPAY_WEBHOOK_SECRET=...

# ------------------------------------------
# Shipping & Logistics - Shiprocket API v2
# Webhook endpoint: https://angelikafashions.com/api/webhooks/logistics
# Header: x-api-key: <SHIPROCKET_WEBHOOK_TOKEN>
# ------------------------------------------
SHIPROCKET_ENV=production
SHIPROCKET_EMAIL=api-user@angelikafashions.com
SHIPROCKET_PASSWORD=...
SHIPROCKET_PICKUP_LOCATION=Primary
SHIPROCKET_PICKUP_PINCODE=500001
SHIPROCKET_WEBHOOK_TOKEN=...
# Optional parcel dimension defaults used ONLY when variant weight/dimensions are not stored in DB
SHIPROCKET_DEFAULT_WEIGHT_KG=0.5
SHIPROCKET_DEFAULT_LENGTH_CM=30
SHIPROCKET_DEFAULT_BREADTH_CM=25
SHIPROCKET_DEFAULT_HEIGHT_CM=5

# ------------------------------------------
# Email (Resend)
# ------------------------------------------
RESEND_API_KEY=...
EMAIL_FROM="Angelika Fashions <vidhya@angelikafashions.com>"
ADMIN_ALERT_EMAIL=vidhya@angelikafashions.com

# ------------------------------------------
# Cache Revalidation & Signed Tokens
# ------------------------------------------
REVALIDATE_SECRET=...
REVALIDATION_SECRET=...
ORDER_TOKEN_SECRET=...

# Optional Instant Mobile OTP Providers (India SMS / WhatsApp)
# Configure ANY one to activate instant Mobile OTP on Checkout
TWOFACTOR_API_KEY=
FAST2SMS_API_KEY=
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=
WHATSAPP_OTP_TEMPLATE_NAME=

# ------------------------------------------
# WhatsApp Business Cloud API (Optional)
# ------------------------------------------
WHATSAPP_PHONE_NUMBER_ID=...
WHATSAPP_ACCESS_TOKEN=...
WHATSAPP_WEBHOOK_VERIFY_TOKEN=...
WHATSAPP_APP_ID=...
WHATSAPP_APP_SECRET=...
WHATSAPP_BUSINESS_ACCOUNT_ID=...

# ------------------------------------------
# Feature Flags
# ------------------------------------------
NEXT_PUBLIC_ENABLE_VIRTUAL_TRYON=false
NEXT_PUBLIC_ENABLE_STYLIST_CHAT=false
